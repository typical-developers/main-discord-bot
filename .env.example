# PostgreSQL database connection options.
DATABASE_USERNAME=postgres # default: postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=postgres # default: postgres
DATABASE_SSL_MODE=disable

# production or development. Controls which set of custom emojis is used.
ENVIRONMENT=production

# Discord bot options.
DISCORD_TOKEN=

# Optional. When set, disgo's cache is stored in Redis.
REDIS_URL= # e.g. redis://localhost:6379/0

LOG_LEVEL=info # debug, info, warn, error

# Moderation.
MODERATION_DISABLE_CAMERA_GUILD_IDS=865737627712749579 # comma separated
MODERATION_GIF_SPAM_CATEGORY_IDS= # comma separated category ids, GIF spam limiting is off when empty
MODERATION_GIF_SPAM_COOLDOWN=5s # default: 5s
MODERATION_GIF_SPAM_MAX_MESSAGES=2 # default: 2

# Users allowed to run /migrate-member-profile, comma separated.
PROFILE_MIGRATION_USER_IDS=399416615742996480
