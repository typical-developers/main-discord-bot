# PostgreSQL database connection options.
DATABASE_USERNAME=postgres # default: postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=postgres # default: postgres
DATABASE_SSL_MODE=disable

# Discord bot options.
DISCORD_TOKEN=

# Optional. When set, disgo's cache is stored in Redis.
REDIS_URL= # e.g. redis://localhost:6379/0

LOG_LEVEL=info # debug, info, warn, error
